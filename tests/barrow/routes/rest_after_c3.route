# Death and retry after Brom's rest taken after the waystone (T4): the rest checkpoint is in the village, so a loss to the
# Warden restores the village (stage 5) and no boss intro runs there; walking back in and into the ring starts it again.
expect mode=title
newgame
until field
choose 0
talk wren
chase slime_a
chase slime_b
talk wren
talk brom
talk corwin
exit east
talk waystone
expect stage=5 cp=3
exit west
choose 0
talk brom
expect cp=9 map=village stage=5
exit east
policy guard
goto 16 7
until death
until field
expect retries=1 cp=9 map=village stage=5 mode=field hp=30 at_cp=1
policy boss:good:1
exit east
goto 16 7
until title
expect mode=title cleared=1 warden_down=1
