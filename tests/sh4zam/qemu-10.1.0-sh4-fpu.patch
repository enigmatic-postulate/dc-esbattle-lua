+
+/* FSCA FPUL,DRn: sine and cosine of the 16-bit binary angle in FPUL (65536 = one turn). */
+void helper_fsca(CPUSH4State *env, uint32_t n)
+{
+    int bank = (env->fpscr & FPSCR_FR) ? 16 : 0;
+    double a = (double)(env->fpul & 0xffff) * (6.283185307179586 / 65536.0);
+    union { float f; uint32_t u; } s = { (float)sin(a) }, c = { (float)cos(a) };
+    env->fregs[bank + n] = make_float32(s.u);
+    env->fregs[bank + n + 1] = make_float32(c.u);
+}
+
+/* PREF @Rn (measurement aid): a non-faulting one-byte load, so that TCG plugins see the address. */
+void helper_pref_probe(CPUSH4State *env, uint32_t addr)
+{
+    void *host;
+    int flags = probe_access_flags(env, addr, 1, MMU_DATA_LOAD, MMU_USER_IDX, true, &host, GETPC());
+    if (!(flags & TLB_INVALID_MASK)) {
+        (void)cpu_ldub_data_ra(env, addr, GETPC());
+    }
+}
